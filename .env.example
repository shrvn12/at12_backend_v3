# --- General ---
NODE_ENV=development
LOG_LEVEL=info
FRONTEND_URL=http://localhost:8080

# --- HTTP services ---
DASHBOARD_PORT=3000
INTERACTION_SERVER_PORT=3001

# --- Postgres ---
DATABASE_URL=postgres://at12:at12@localhost:5432/at12
PG_POOL_MAX=10

# --- Redis (cache only — app must run with Redis down, just slower) ---
REDIS_URL=redis://localhost:6379
SONG_CACHE_TTL_SECONDS=3600
SEARCH_CACHE_TTL_SECONDS=1800
HOME_FEED_CACHE_TTL_SECONDS=86400
PLAYLIST_CACHE_TTL_SECONDS=86400
PROFILE_CACHE_TTL_SECONDS=3600

# --- RabbitMQ ---
RABBITMQ_URL=amqp://localhost:5672
QUEUE_MAX_RETRIES=5

# --- Auth (shared secret between Dashboard and Interaction Server) ---
JWT_SECRET=change-me
JWT_EXPIRY=7d
AUTH_COOKIE_NAME=token
BCRYPT_SALT_ROUNDS=10

# Externally-reachable URL for the Dashboard itself - used to build the
# verify-email link (that page is rendered by Dashboard directly, not by
# the frontend).
DASHBOARD_PUBLIC_URL=http://localhost:3000

# --- Scheduler ---
SCHEDULER_HOURLY_CRON=0 * * * *
SCHEDULER_DAILY_CRON=0 3 * * *
HOME_FEED_STALE_HOURS=24
PLAYLIST_STALE_HOURS=24

# --- Song lifecycle ---
SONG_STATS_STALE_HOURS=24
SONG_RETENTION_DAYS=180

# --- YouTube / music data source ---
YOUTUBE_API_KEY=

# --- Email (nodemailer) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AT12 <no-reply@at12.app>"
